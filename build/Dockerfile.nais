# The NAV build of public muninn, on Docker Hardened Images (DHI) Bun, Debian 13.
#
# Replaces muninn's own Dockerfile for this deployment only. Compose keeps
# building upstream's. The build context is the muninn checkout after the
# workflow's overlay: this repo's bots/ and build/nais-entrypoint.ts are copied
# in, the answer scanner lands under nais-skanner/, and `bots/` is stripped
# from .dockerignore.
#
# Both base images are MIRRORS in the team's GAR, pinned by digest. CI has no
# dhi.io credential; see docs/runtime-image.md for the mirror command and for
# how to move a digest. Build and runtime come from the same DHI release, so the
# native modules bun installs against glibc here load there.
#
# The workflow pins the sha256 of upstream's whole Dockerfile and entrypoint,
# and its start script (build/upstream-dockerfile-pin.txt). Any upstream change
# to them stops the deploy until it is mirrored here and re-pinned.

# --- build: has a shell and a package manager; nothing from it ships but /app ---
FROM europe-north1-docker.pkg.dev/nais-management-233d/teammelosys/dhi-bun:1.4.2-debian13.7-dev@sha256:d291d2c4fec5855c36e206cdee07cb046d16e132b0fecb7ad0d68bab9c1853d3 AS build
WORKDIR /app

COPY package.json bun.lock ./
RUN bun install --frozen-lockfile --production

# The embedding model, baked through the one loader that throws (upstream's
# Dockerfile explains both choices). The runtime has no egress to the model host.
COPY src/logging.ts ./src/logging.ts
COPY src/ai/embeddings.ts ./src/ai/embeddings.ts
RUN bun -e 'const { loadEmbeddingModel } = await import("./src/ai/embeddings.ts"); \
            await loadEmbeddingModel(); \
            console.log("[build] embedding model baked");'

COPY src ./src
COPY db ./db
COPY tsconfig.json ./
# Not upstream's optional `bot[s]` glob: this image is useless without the
# overlay, so a missing bots/ fails the build here.
COPY bots ./bots/
COPY nais-entrypoint.ts ./
# The answer scanner muninn loads through WIKI_ANSWER_SCANNER (nais/app.yaml):
# build/svar-skanner.ts and the publish script it imports, in the same relative
# layout as this repo. Its own directory, so it cannot collide with muninn's
# scripts/.
COPY nais-skanner ./nais-skanner/

# --- runtime: no shell, no package manager, non-root (65532) ---
FROM europe-north1-docker.pkg.dev/nais-management-233d/teammelosys/dhi-bun:1.4.2-debian13.7@sha256:be53b056dc651b7c83471e90fdb69c9614c83d5860e21b944df436bc6d86b5ba
# COPY before WORKDIR: a WORKDIR created first is owned by the image user
# (65532), so the app could write into /app. Created by COPY, /app is root's.
# The pod also runs with a read-only root filesystem (LOG_DIR=none).
COPY --from=build /app /app
WORKDIR /app

# Upstream's image pins these; the app defaults (3010, 127.0.0.1) are
# unreachable in a pod.
ENV DASHBOARD_PORT=3000
ENV DASHBOARD_HOST=0.0.0.0
EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=3 \
  CMD ["bun", "-e", "const p = process.env.DASHBOARD_PORT || 3000; const r = await fetch('http://127.0.0.1:' + p + '/api/live'); if (!r.ok) process.exit(1);"]

ENTRYPOINT ["bun", "/app/nais-entrypoint.ts"]
